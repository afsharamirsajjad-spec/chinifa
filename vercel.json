{
  "version": 2,
  "redirects": [
    {
      "source": "/Chinifa.apk",
      "destination": "https://github.com/afsharamirsajjad-spec/chinifa/releases/download/v2.4.0/Chinifa.apk",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/auth",
      "destination": "/api/auth.js"
    },
    {
      "source": "/api/login",
      "destination": "/api/auth.js?action=login"
    },
    {
      "source": "/api/register",
      "destination": "/api/auth.js?action=register"
    },
    {
      "source": "/api/session",
      "destination": "/api/auth.js?action=session"
    },
    {
      "source": "/api/app-version",
      "destination": "/website/version.json"
    },
    {
      "source": "/api/version",
      "destination": "/website/version.json"
    },
    {
      "source": "/version.json",
      "destination": "/website/version.json"
    },
    {
      "source": "/api/media-proxy",
      "destination": "/api/media-proxy.js"
    },
    {
      "source": "/media-proxy/:path*",
      "destination": "https://media.kanchinese.app/:path*"
    },
    {
      "source": "/game/:path*",
      "destination": "/UI-code/game/:path*"
    },
    {
      "source": "/app/game/:path*",
      "destination": "/UI-code/game/:path*"
    },
    {
      "source": "/stack/:path*",
      "destination": "https://kanchinese.app/stack/:path*"
    },
    {
      "source": "/app/stack/:path*",
      "destination": "https://kanchinese.app/stack/:path*"
    },
    {
      "source": "/admin/fonts/vazir.woff2",
      "destination": "/UI-code/css/fonts/Vazirmatn-Variable.woff2"
    },
    {
      "source": "/app",
      "destination": "/UI-code/index.html"
    },
    {
      "source": "/app/",
      "destination": "/UI-code/index.html"
    },
    {
      "source": "/app/index.html",
      "destination": "/UI-code/index.html"
    },
    {
      "source": "/app/:path*",
      "destination": "/UI-code/:path*"
    },
    {
      "source": "/admin",
      "destination": "/tools/admin/index.html"
    },
    {
      "source": "/admin/",
      "destination": "/tools/admin/index.html"
    },
    {
      "source": "/admin/index.html",
      "destination": "/tools/admin/index.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/tools/admin/:path*"
    },
    {
      "source": "/tools/admin/:path*",
      "destination": "/tools/admin/:path*"
    },
    {
      "source": "/toon",
      "destination": "/website/chinifa-toon.html"
    },
    {
      "source": "/chinifa-toon",
      "destination": "/website/chinifa-toon.html"
    },
    {
      "source": "/website",
      "destination": "/website/index.html"
    },
    {
      "source": "/website/",
      "destination": "/website/index.html"
    },
    {
      "source": "/website/:path*",
      "destination": "/website/:path*"
    },
    {
      "source": "/style.css",
      "destination": "/website/style.css"
    },
    {
      "source": "/main.js",
      "destination": "/website/main.js"
    },
    {
      "source": "/assets/:path*",
      "destination": "/website/assets/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/",
      "destination": "/website/index.html"
    }
  ],
  "headers": [
    {
      "source": "/app/(.*)\\.(bundle\\.js|bundle\\.css|woff2|jpg|webp|png|svg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/app/service-worker.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}