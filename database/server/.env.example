# واژه‌نگار چینی — auth server config
# Copy to server/.env and fill in the keys you want. Missing keys = that channel
# is unavailable (production) or OTPs print to the server console (development).

# Server
PORT=8787
# NODE_ENV=production          # set in production — required for real sending
# EXTRA_ORIGINS=https://your-domain.example

# --- News admin API ---
# Bearer key the admin panel sends for news create/edit/delete + image upload.
# Change this before going live (پنل مدیریت → تب اخبار → کلید مدیریت سرور).
ADMIN_KEY=chinify-admin

# --- SMS OTP (Iranian mobiles only) : Kavenegar Verify/Lookup ---
# 1. Create an API key at https://app.kavenegar.com  (Settings -> API Key)
# 2. Create an approved OTP template containing "%token"  (Settings -> OTP Templates)
KAVENEGAR_API_KEY=
KAVENEGAR_TEMPLATE=

# --- Email OTP : Resend ---
# 1. Create an API key at https://resend.com/api-keys
# 2. EMAIL_FROM must be a verified sender; onboarding@resend.dev only reaches
#    your own account's address (fine for testing).
RESEND_API_KEY=
EMAIL_FROM=واژه‌نگار چینی <onboarding@resend.dev>

# --- OTP policy (defaults shown) ---
OTP_TTL_SECONDS=180
OTP_RESEND_COOLDOWN=60
OTP_MAX_ATTEMPTS=5
OTP_REQUESTS_PER_HOUR=5
OTP_REQUESTS_PER_IP_HOUR=30
OTP_VERIFY_FAILS_PER_IP_HOUR=20

# --- Sessions ---
SESSION_TTL_DAYS=30

# --- Development helpers ---
# Force OTP codes to the server stdout even if NODE_ENV=production (never do this in real prod)
DEV_OTP_LOG=false
